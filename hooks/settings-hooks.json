{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/software/claude-config/hooks/notify-sound.sh atencio",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/software/claude-config/hooks/notify-sound.sh fi",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/projects/software/claude-config/hooks/notify-sound.sh inici",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash ~/projects/software/claude-config/hooks/prompt-log.sh"
          }
        ]
      }
    ]
  }
}
